<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>KoruMsSqlYedek.Engine</RootNamespace>
    <AssemblyName>KoruMsSqlYedek.Engine</AssemblyName>
    <LangVersion>latest</LangVersion>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
    <Copyright>Copyright © 2026 Zafer Bilgisayar</Copyright>
    <Authors>Hüzeyin Küçük</Authors>
    <Company>Zafer Bilgisayar</Company>
  </PropertyGroup>

  <ItemGroup>
    <!-- Logging -->
    <PackageReference Include="Serilog" Version="4.3.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />

    <!-- JSON -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />

    <!-- Windows Service API -->
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.7" />

    <!-- SQL Client -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.1" />

    <!-- Scheduling -->
    <PackageReference Include="Quartz" Version="3.18.1" />

    <!-- SQL Server Backup (SMO) -->
    <PackageReference Include="Microsoft.SqlServer.SqlManagementObjects" Version="181.19.0" />

    <!-- Compression -->
    <PackageReference Include="Squid-Box.SevenZipSharp" Version="1.6.2.24" />

    <!-- E-posta -->
    <PackageReference Include="MailKit" Version="4.16.0" />

    <!-- IoC -->
    <PackageReference Include="Autofac" Version="9.1.0" />

    <!-- VSS - Açık/kilitli dosya desteği -->
    <PackageReference Include="AlphaVSS" Version="2.0.3" />
    <PackageReference Include="AlphaVSS.Native.NetCore" Version="2.0.3" />

    <!-- Cloud: Google Drive -->
    <PackageReference Include="Google.Apis.Drive.v3" Version="1.73.0.4112" />

    <!-- Cloud: FTP/SFTP -->
    <PackageReference Include="FluentFTP" Version="54.1.1" />
    <PackageReference Include="SSH.NET" Version="2025.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KoruMsSqlYedek.Core\KoruMsSqlYedek.Core.csproj" />
  </ItemGroup>

  <!-- Birim testleri internal yardımcılara (EscapeQuery, bağlantı dizesi, identifier escape) erişir -->
  <ItemGroup>
    <InternalsVisibleTo Include="KoruMsSqlYedek.Tests" />
  </ItemGroup>

  <!-- 7z.dll native library — SevenZipSharp runtime dependency -->
  <ItemGroup>
    <Content Include="Native\x64\7z.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>x64\7z.dll</Link>
    </Content>
  </ItemGroup>

  <!--
    AlphaVSS platform DLL'leri — .NET 10'da NuGet .targets tetiklenmiyor.
    7z.dll ile aynı yöntem: Native klasöründen Content olarak eklenir,
    proje referansı üzerinden Service ve Win çıktılarına otomatik kopyalanır.
  -->
  <ItemGroup>
    <Content Include="Native\AlphaVSS.x64.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>AlphaVSS.x64.dll</Link>
    </Content>
    <Content Include="Native\AlphaVSS.x86.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>AlphaVSS.x86.dll</Link>
    </Content>
  </ItemGroup>

  <!--
    AlphaVSS MSBuild target artık gerekli değil — Content item'ları halleder.
    Eski target kaldırıldı.
  -->

  <!--
    Disk imajı yedekleme (wimlib) artık çekirdekte değil.
    KoruMsSqlYedek.Plus deposunda eklenti derlemesi olarak dağıtılır ve
    çalışma zamanında Plugins\ klasöründen yüklenir (bkz. Plugins\PluginLoader).
  -->
</Project>
